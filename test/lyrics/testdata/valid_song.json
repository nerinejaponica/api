      {
        "lines": [
          { "ja": "{夜|よる}の{底|そこ}", "romaji": "yoru no soko" }
        ],
        "translations": [
          { "span": 1, "text": "Dasar malam" }
        ]
      }
    ]
  },
  "footnotes": [
    { "id": 1, "text": "Izayoi: bulan malam ke-16 dalam kalender lunar." }
